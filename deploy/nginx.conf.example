# ============================================================
# finnbot · Nginx 反代配置示例
# 放置位置（二选一）：
#   Ubuntu/Debian: /etc/nginx/sites-available/finnbot.conf，并软链到 sites-enabled
#   CentOS/RHEL:   /etc/nginx/conf.d/finnbot.conf
# 企业微信回调强制 HTTPS + 已备案域名；80 端口仅用于证书签发/重定向。
# ============================================================

# 80 端口：HTTP → HTTPS 重定向，并预留证书校验路径
server {
    listen 80;
    server_name bot.your-domain.com;   # ← 改成你的域名

    # certbot 申请证书时用的校验路径（standalone 模式可忽略）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 443 端口：HTTPS 终止 + 反代到后端
server {
    listen 443 ssl http2;
    server_name bot.your-domain.com;   # ← 改成你的域名

    # ---- 证书（certbot 默认路径，按实际调整）----
    ssl_certificate     /etc/letsencrypt/live/bot.your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!RC4;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # ---- 安全响应头 ----
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 支持发票图片上传，放宽 body 大小
    client_max_body_size 20m;

    # ---- 企业微信回调 ----
    location = /wecom/callback {
        proxy_pass http://127.0.0.1:8000/wecom/callback;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # ---- 健康检查 ----
    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
        access_log off;
    }

    # 其余路径一律拒绝，缩小暴露面
    location / {
        return 404;
    }
}
