# ===== 企业微信（管理后台 → 自建应用）=====
WECOM_CORP_ID=你的企业CorpID
WECOM_AGENT_ID=你的应用AgentId
WECOM_CORP_SECRET=你的应用Secret
WECOM_CALLBACK_TOKEN=接收消息处自定义的Token
WECOM_ENCODING_AES=接收消息处生成的EncodingAESKey

# ===== 大模型（OpenAI 兼容接口）=====
# 腾讯混元示例；也可换通义/文心等，改 BASE_URL / MODEL 即可
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_API_KEY=你的大模型APIKey
LLM_MODEL=hunyuan-pro

# ===== 知识库 =====
# local=本地轻量检索（默认，零外部服务）；rag=接入外部向量库
KNOWLEDGE_MODE=local
KNOWLEDGE_DIR=knowledge
RAG_API_URL=
RAG_API_KEY=

# ===== 发票查验 / OCR（按需配置）=====
# 发票查验服务商：聚合类（票易通/慧穗/票查查等）。填服务商标识后启用真实查验。
# INVOICE_PROVIDER 填你服务商约定标识（如 piaoyitong / huishui / piaochacha）；
# 具体 ①签名拼接种子 ②请求路径 ③返回字段 以该服务商文档为准（已在 invoice.py
#   verify_invoice_aggregator 给出标准范式，按注释微调 3 处即可），其余已做兼容解析。
# 留空则仅做本地风险校验 + 引导。
INVOICE_PROVIDER=
INVOICE_API_BASE=https://api.你的查验服务商.com
INVOICE_API_KEY=
INVOICE_APP_ID=
INVOICE_APP_SECRET=
# OCR 服务商（图片/PDF 直接结构化）：留空则手动输入四要素
INVOICE_OCR_PROVIDER=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
WEBHOOK_PATH=/wecom/callback
